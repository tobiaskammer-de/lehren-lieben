---
import { latestTwo } from '~/data/episodes';
import { asset } from '~/lib/url';
import Listen from '~/components/player/Listen.astro';

const latest = latestTwo();
const allEpisodesHref = asset('episoden/');
---

<section id="episoden">
  <div class="container-page">
    <div
      class="s-header"
      style="display: flex; align-items: flex-end; justify-content: space-between;"
    >
      <div class="reveal">
        <span class="eyebrow">Reinhören</span>
        <h2 class="s-title">Frisch raus.</h2>
      </div>
      <a
        href={allEpisodesHref}
        class="btn btn-outline reveal"
        style="margin-bottom: 6px;"
      >
        Alle Folgen
      </a>
    </div>
    <div class="ep-grid">
      {
        latest.map((e, i) => (
          <article
            class={`ep-card reveal${i === 1 ? ' reveal-d1' : ''}`}
            data-ep-card={e.id}
            data-cls={e.cls}
          >
            <div class={`ep-top-bar ${e.cls}`} />
            <div class="ep-show-row">
              <span class={`ep-show ${e.cls}`}>{e.show}</span>
              {e.ep && <span class="ep-num">{e.ep}</span>}
            </div>
            <h3 class="ep-title">{e.title}</h3>
            <p class="ep-desc">{e.desc}</p>
            <Listen ep={e} />
          </article>
        ))
      }
    </div>

    <div class="random-bar reveal">
      <div>
        <div class="random-title">Nicht sicher, wo anfangen?</div>
        <div class="random-sub">
          Lass uns eine zufällige Episode für dich aussuchen.
        </div>
      </div>
      <button class="btn btn-amber" id="random-btn">
        Lass den Zufall entscheiden
      </button>
    </div>
    <div id="random-result" hidden></div>
  </div>
</section>

<script>
  import { catalog } from '~/lib/player/catalog';
  import { episodeCardHTML, syncCards } from '~/lib/player/bind';

  // Pro Seite binden — nach einem Seitenwechsel ist der Button ein neues Element.
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('random-btn');
    const out = document.getElementById('random-result');
    if (!btn || !out) return;

    let lastIndex = -1;
    btn.addEventListener('click', () => {
      const list = catalog().list;
      if (!list.length) return;
      let i = Math.floor(Math.random() * list.length);
      // Nicht zweimal hintereinander dieselbe Folge
      if (list.length > 1 && i === lastIndex) i = (i + 1) % list.length;
      lastIndex = i;
      out.innerHTML = episodeCardHTML(list[i]);
      out.hidden = false;
      syncCards();
    });
  });
</script>
