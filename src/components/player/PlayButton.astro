---
// Abspiel-Button für Folgen-Karten. Ohne Audio-Datei: Link zu Podigee.
import type { Episode } from '~/data/episodes';
import { playButtonHTML } from '~/lib/player/markup';

interface Props {
  ep: Pick<Episode, 'id' | 'cls' | 'title' | 'audio' | 'url'>;
  variant?: 'pill' | 'round';
  label?: string;
}

const { ep, variant = 'pill', label = 'Abspielen' } = Astro.props;
---

{
  ep.audio ? (
    <Fragment set:html={playButtonHTML(ep, variant, label)} />
  ) : (
    <a class={`ep-btn ${ep.cls}`} href={ep.url} target="_blank" rel="noopener">
      Hören
    </a>
  )
}
